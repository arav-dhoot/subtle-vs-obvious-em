# Copy to .env and fill in. Every script is run as `uv run --env-file .env ...`,
# which loads this file into the process environment.

# Tinker — training and native sampling for every model except Gemma, and the
# Petri targets. Not needed for scripts/run_gpu_sweep.py.
TINKER_API_KEY=

# OpenRouter — the judge gateway (gpt-4o for the free-form eval, Sonnet 5 as
# Petri's auditor and judge). Required for any eval.
OPENROUTER_API_KEY=

# Weights & Biases — training/eval metrics. Required unless you pass --no-wandb.
# WANDB_MODE=offline works without a key if you only want local logs.
# eval/petri/build_targets.py reads the training runs back from this project.
WANDB_API_KEY=
# WANDB_PROJECT=scaling-em

# Hugging Face — optional. Uploads results (`--save-to hf`) and, on the GPU path,
# each adapter as it is saved (otherwise the local save is the only copy).
# The token must have write access to HF_REPO's namespace.
HF_TOKEN=
# HF_REPO=<your-hf-user>/subtle-vs-obvious-em-adapters

# Anthropic — only for --judge-provider anthropic. Optional.
# ANTHROPIC_API_KEY=
